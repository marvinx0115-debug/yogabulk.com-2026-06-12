---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../data/site";

const guides = [
  { slug: 'buy-yoga-leggings-wholesale', title: 'How to Buy Yoga Leggings Wholesale', desc: 'The complete guide to sourcing quality yoga leggings at factory prices. MOQ, pricing, quality indicators, and negotiation tips.', icon: '🩱', readTime: '8 min', level: 'Beginner' },
  { slug: 'how-to-start-activewear-brand', title: 'How to Start an Activewear Brand', desc: 'From zero to selling: the step-by-step roadmap for building a profitable activewear brand in 2024-2025.', icon: '🚀', readTime: '12 min', level: 'All Levels' },
  { slug: 'activewear-fabric-guide', title: 'Activewear Fabric & Quality Guide', desc: 'Nylon vs Polyester vs Bamboo. What makes a pair of leggings squat-proof? Understand fabric to buy smarter.', icon: '🧵', readTime: '10 min', level: 'Intermediate' },
  { slug: 'shipping-guide-fba-express', title: 'Shipping Guide: FBA vs Express vs Sea', desc: 'Compare DHL express, Amazon FBA, and sea freight for activewear. Find the cheapest and fastest option for your business.', icon: '🚢', readTime: '9 min', level: 'All Levels' },
  { slug: 'how-to-source-activewear-suppliers', title: 'How to Source Activewear Suppliers', desc: 'Alibaba, trade shows, or direct factory? A practical guide to finding and vetting reliable activewear suppliers.', icon: '🔍', readTime: '11 min', level: 'Intermediate' },
];
---
<BaseLayout title="Wholesale Resource Center" description="Free wholesale buying guides for activewear entrepreneurs. Learn how to source yoga leggings, start your brand, understand fabrics, and optimize shipping.">
  <section style="background:var(--color-primary);color:white;">
    <div style="max-width:56rem;margin:0 auto;padding:4rem 1.5rem;text-align:center;">
      <p style="color:var(--color-accent-light);font-weight:500;font-size:0.875rem;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.5rem;">Free Wholesale Guides</p>
      <h1 style="font-size:2.5rem;font-weight:800;margin-bottom:1rem;">Wholesale Resource Center</h1>
      <p style="color:#94a3b8;max-width:42rem;margin:0 auto;">Practical guides to help you source better, price smarter, and grow your activewear business faster.</p>
    </div>
  </section>

  <div style="max-width:56rem;margin:0 auto;padding:3rem 1.5rem;">
    <div style="display:flex;flex-direction:column;gap:1.25rem;">
      {guides.map((g, i) => (
        <a href={"/resources/" + g.slug} style="display:flex;align-items:flex-start;gap:1.25rem;background:white;border:1px solid var(--color-border);border-radius:1rem;padding:1.5rem;text-decoration:none;transition:box-shadow 0.2s,transform 0.2s;" onmouseover="this.style.boxShadow='0 4px 20px rgba(0,0,0,0.1)';this.style.transform='translateY(-2px)'" onmouseout="this.style.boxShadow='none';this.style.transform='none'">
          <div style="width:3rem;height:3rem;background:var(--color-secondary);border-radius:0.75rem;display:flex;align-items:center;justify-content:center;font-size:1.5rem;flex-shrink:0;">{g.icon}</div>
          <div style="flex:1;min-width:0;">
            <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.5rem;">
              <span style="font-size:0.75rem;font-weight:700;color:var(--color-accent);background:var(--color-secondary);padding:0.2rem 0.6rem;border-radius:9999px;">{g.level}</span>
              <span style="font-size:0.75rem;color:var(--color-text-light);">{g.readTime} read</span>
            </div>
            <h2 style="font-size:1.1rem;font-weight:700;color:var(--color-primary);margin-bottom:0.4rem;">{g.title}</h2>
            <p style="font-size:0.875rem;color:var(--color-text-light);line-height:1.5;">{g.desc}</p>
          </div>
          <svg style="width:1.5rem;height:1.5rem;color:var(--color-text-light);flex-shrink:0;align-self:center;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      ))}
    </div>
  </div>

  <div style="max-width:56rem;margin:0 auto;padding:0 1.5rem 3rem;">
    <div style="background:var(--color-secondary);border-radius:1.5rem;padding:2rem;text-align:center;">
      <h2 style="font-size:1.25rem;font-weight:800;color:var(--color-primary);margin-bottom:0.5rem;">Need a Custom Guide?</h2>
      <p style="font-size:0.875rem;color:var(--color-text-light);margin-bottom:1.25rem;">Ask us on WhatsApp and we will create a personalized sourcing guide for your specific business.</p>
      <a href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:0.5rem;background:var(--color-whatsapp);color:white;padding:0.875rem 2rem;border-radius:9999px;font-weight:700;">Chat on WhatsApp</a>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
      { "@type": "ListItem", "position": 2, "name": "Resources", "item": SITE.url + "/resources" },
    ],
  })} />
</BaseLayout>
