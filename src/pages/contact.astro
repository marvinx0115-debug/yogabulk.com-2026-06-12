---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout title="Contact Us" description="Contact Wholesale Yoga for activewear wholesale inquiries. WhatsApp, email, or visit our office in Hefei, China.">
  <!-- Hero -->
  <section class="bg-[var(--color-primary)] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <p class="text-[var(--color-accent-light)] font-medium text-sm tracking-widest uppercase mb-2">Get In Touch</p>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4">Contact Us</h1>
      <p class="text-gray-300 max-w-xl">Fastest response via WhatsApp. We reply within 30 minutes during business hours (9AM-6PM CST, Mon-Sat).</p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <!-- Contact Info -->
      <div>
        <h2 class="text-2xl font-bold text-[var(--color-primary)] mb-8">Reach Us Directly</h2>

        <!-- WhatsApp Card -->
        <a
          href={SITE.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="block bg-[var(--color-whatsapp)] text-white rounded-2xl p-8 mb-6 hover:bg-green-600 transition-colors group"
        >
          <div class="flex items-center gap-4 mb-3">
            <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.5.5 0 00.611.611l4.458-1.495A11.952 11.952 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-2.387 0-4.607-.795-6.392-2.135l-.446-.345-3.22 1.079 1.079-3.22-.345-.446A9.935 9.935 0 012 12C2 6.486 6.486 2 12 2s10 4.486 10 10-4.486 10-10 10z"/></svg>
            <div>
              <p class="font-bold text-lg">WhatsApp (Recommended)</p>
              <p class="text-green-100 text-sm">+{SITE.whatsapp}</p>
            </div>
            <span class="ml-auto text-2xl group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-green-100 text-sm">Instant response · Share images · Get quote in minutes</p>
        </a>

        <!-- Other Contact Methods -->
        <div class="space-y-6">
          <div class="bg-[var(--color-secondary)] rounded-2xl p-6">
            <p class="text-xs text-[var(--color-text-light)] uppercase tracking-wider mb-1">Email</p>
            <p class="font-semibold text-[var(--color-text)]">{SITE.email}</p>
          </div>
          <div class="bg-[var(--color-secondary)] rounded-2xl p-6">
            <p class="text-xs text-[var(--color-text-light)] uppercase tracking-wider mb-1">Address</p>
            <p class="font-semibold text-[var(--color-text)]">{SITE.address}</p>
          </div>
          <div class="bg-[var(--color-secondary)] rounded-2xl p-6">
            <p class="text-xs text-[var(--color-text-light)] uppercase tracking-wider mb-1">Business Hours</p>
            <p class="font-semibold text-[var(--color-text)]">Mon-Sat, 9:00 AM - 6:00 PM (CST, UTC+8)</p>
          </div>
        </div>
      </div>

      <!-- Inquiry Form (Simple, WhatsApp-forwarding) -->
      <div>
        <div class="bg-white border border-[var(--color-border)] rounded-2xl p-8">
          <h2 class="text-xl font-bold text-[var(--color-primary)] mb-6">Send Quick Inquiry</h2>
          <form action="https://formspree.io/f/mbdbeqlv" method="POST" class="space-y-5">
            <input type="hidden" name="_subject" value="New Wholesale Inquiry" />
            <div>
              <label class="block text-sm font-medium text-[var(--color-text)] mb-1">Your Name *</label>
              <input type="text" name="name" id="form-name" required class="w-full border border-[var(--color-border)] rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]" placeholder="John Smith" />
            </div>
            <div>
              <label class="block text-sm font-medium text-[var(--color-text)] mb-1">Email *</label>
              <input type="email" name="_replyto" id="form-email" required class="w-full border border-[var(--color-border)] rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]" placeholder="you@email.com" />
            </div>
            <div>
              <label class="block text-sm font-medium text-[var(--color-text)] mb-1">Your Business</label>
              <input type="text" name="business" id="form-business" class="w-full border border-[var(--color-border)] rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]" placeholder="Amazon Seller / Yoga Studio / Shopify Store" />
            </div>
            <div>
              <label class="block text-sm font-medium text-[var(--color-text)] mb-1">What Are You Looking For? *</label>
              <textarea name="message" id="form-message" required rows="4" class="w-full border border-[var(--color-border)] rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] resize-none" placeholder="E.g., 50pcs scrunch butt leggings in black and mocha, custom logo needed"></textarea>
            </div>
            <button
              type="submit"
              class="w-full bg-[var(--color-cta)] text-white py-3.5 rounded-full font-semibold hover:bg-[var(--color-cta-hover)] transition-colors"
            >
              Send Inquiry
            </button>
            <p class="text-xs text-[var(--color-text-light)] text-center">We'll reply within 24 hours</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- BreadcrumbList Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
      { "@type": "ListItem", "position": 2, "name": "Contact", "item": `${SITE.url}/contact` }
    ]
  })} />
</BaseLayout>
