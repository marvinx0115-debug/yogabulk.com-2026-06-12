---
import BaseLayout from '../layouts/BaseLayout.astro';
import InternalLinks from '../components/InternalLinks.astro';
import { SITE, FEATURES, CATEGORIES, STEPS, TESTIMONIALS, HOME_FAQS } from '../data/site';
import { products } from '../data/products';

const bestSellers = products.slice(0, 8);

const title = "Wholesale Activewear Supplier | Yoga Leggings Bulk MOQ 30-50";
const description = "China wholesale activewear supplier. Ready-to-ship yoga leggings, sports bras, matching sets. MOQ 30-50pcs, 3-7 day shipping, custom logo. 300+ styles in stock. Trusted by 200+ brands.";
const keywords = ['wholesale yoga leggings', 'activewear manufacturer', 'gym wear supplier', 'private label fitness apparel', 'bulk sports bras'];
---

<BaseLayout 
  title={title}
  description={description}
  keywords={keywords}
  type="website"
>
  <!-- Hero Section -->
  <section class="relative bg-[var(--color-primary)] text-white overflow-hidden">
    <!-- Background Image - full cover with gradient overlay -->
    <div class="absolute inset-0 z-0">
      <img src="/images/hero-bg.webp" alt="Wholesale activewear collection ready to ship from China factory" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-primary)]/75 via-[var(--color-primary)]/50 to-[var(--color-primary)]/20"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 py-14 md:py-32">
      <div class="max-w-3xl">
        <p class="text-[var(--color-accent-light)] font-medium text-xs sm:text-sm tracking-widest uppercase mb-3 sm:mb-4">Ready To Ship · Factory Direct</p>
        <h1 class="text-3xl sm:text-4xl md:text-6xl font-extrabold leading-tight mb-4 sm:mb-6">
          ACTIVEWEAR<br/>WHOLESALE
        </h1>
        <p class="text-base sm:text-lg md:text-xl text-gray-300 mb-6 sm:mb-8 max-w-xl leading-relaxed">
          Low MOQ 30-50pcs · Fast Shipping 3-7 Days · Custom Logo · 300+ In-Stock Styles
        </p>
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
          <a
            href={SITE.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-[var(--color-whatsapp)] text-white px-6 sm:px-8 py-3.5 rounded-full font-semibold hover:bg-green-600 transition-colors text-center text-sm sm:text-base"
          >
            Get Quote on WhatsApp →
          </a>
          <a
            href="/catalog-read/?page=1"
            class="border border-gray-500 bg-white text-gray-900 px-6 sm:px-8 py-3.5 rounded-full font-semibold hover:bg-gray-100 transition-colors text-center text-sm sm:text-base"
          >
            View Product Catalog
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Phase 2 Quick Links -->
  <section class="bg-gradient-to-r from-blue-600 to-purple-600 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
      <div class="flex flex-wrap justify-center gap-3 sm:gap-4">
        <a href="/inventory/" class="bg-white/20 hover:bg-white/30 text-white px-4 py-2 rounded-full text-sm font-medium transition flex items-center gap-2">
          📦 Inventory Hub
        </a>
        <a href="/data/yoga-leggings-wholesale-pricing/" class="bg-white/20 hover:bg-white/30 text-white px-4 py-2 rounded-full text-sm font-medium transition flex items-center gap-2">
          💰 Wholesale Pricing
        </a>
        <a href="/data/activewear-moq-guide/" class="bg-white/20 hover:bg-white/30 text-white px-4 py-2 rounded-full text-sm font-medium transition flex items-center gap-2">
          📋 MOQ Guide
        </a>
        <a href="/buyers/amazon-fba/" class="bg-white/20 hover:bg-white/30 text-white px-4 py-2 rounded-full text-sm font-medium transition flex items-center gap-2">
          🚀 Amazon FBA
        </a>
        <a href="/buyers/tiktok-shop/" class="bg-white/20 hover:bg-white/30 text-white px-4 py-2 rounded-full text-sm font-medium transition flex items-center gap-2">
          📱 TikTok Shop
        </a>
      </div>
    </div>
  </section>

  <!-- Category Quick Links -->
  <section class="bg-[var(--color-secondary)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 sm:py-8">
      <div class="grid grid-cols-3 md:grid-cols-6 gap-2 sm:gap-3">
        {CATEGORIES.map((cat) => (
          <a
            href={`/products#${cat.slug}`}
            class="bg-white rounded-lg sm:rounded-xl p-2.5 sm:p-4 text-center hover:shadow-md transition-shadow group"
          >
            <p class="font-semibold text-xs sm:text-sm text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors">{cat.name}</p>
            <p class="text-[10px] sm:text-xs text-[var(--color-text-light)] mt-0.5 sm:mt-1">{cat.count}+ styles</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Best Sellers -->
  <section class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 overflow-hidden rounded-2xl">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img src="/images/hero-bg.webp" alt="Wholesale activewear collection ready to ship from China factory" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-white/85"></div>
    </div>
    <div class="relative z-10">
    <div class="text-center mb-8 sm:mb-12">
      <p class="text-[var(--color-accent)] font-medium text-xs sm:text-sm tracking-widest uppercase mb-2">Top Picks</p>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-[var(--color-primary)]">Best Sellers</h2>
      <p class="text-sm sm:text-base text-[var(--color-text-light)] mt-2 sm:mt-3">TikTok & Amazon verified trending styles</p>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
      {bestSellers.map((product) => (
        <a href={`/products/${product.slug}/`} class="group bg-white border border-[var(--color-border)] rounded-xl sm:rounded-2xl overflow-hidden hover:shadow-lg transition-all">
          <div class="aspect-square bg-[var(--color-secondary)] flex items-center justify-center overflow-hidden">
            <img src={product.images[0]} alt={product.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
          </div>
          <div class="p-2.5 sm:p-4">
            <p class="text-[10px] sm:text-xs text-[var(--color-accent)] font-medium mb-0.5 sm:mb-1">{product.category}</p>
            <h3 class="font-semibold text-xs sm:text-sm text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors leading-tight">{product.name}</h3>
            <div class="flex items-center gap-1.5 sm:gap-2 mt-1.5 sm:mt-2">
              <span class="text-[10px] sm:text-xs font-medium text-[var(--color-stock-green)]">● {product.stock}</span>
              <span class="text-[10px] sm:text-xs text-[var(--color-text-light)]">MOQ {product.moq}</span>
            </div>
            <p class="text-xs sm:text-sm font-bold text-[var(--color-primary)] mt-1.5 sm:mt-2">{product.price}<span class="text-[10px] sm:text-xs font-normal text-gray-500"> /pc</span></p>
          </div>
        </a>
      ))}
    </div>
    <div class="text-center mt-8 sm:mt-10">
      <a href="/products/" class="inline-block border-2 border-[var(--color-primary)] text-[var(--color-primary)] px-6 sm:px-8 py-3 rounded-full font-semibold text-sm sm:text-base hover:bg-[var(--color-primary)] hover:text-white transition-colors">
        View All Products →
      </a>
    </div>
  </section>

  <!-- 5 Core Advantages -->
  <section class="bg-[var(--color-secondary)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
      <div class="text-center mb-8 sm:mb-12">
        <p class="text-[var(--color-accent)] font-medium text-xs sm:text-sm tracking-widest uppercase mb-2">Why Choose Us</p>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-[var(--color-primary)]">6 Core Advantages</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-6">
        {FEATURES.map((f) => (
          <div class="bg-white rounded-xl sm:rounded-2xl p-4 sm:p-8 text-center hover:shadow-md transition-shadow">
            <div class="text-2xl sm:text-4xl mb-2 sm:mb-4">{f.icon}</div>
            <h3 class="text-sm sm:text-lg font-bold text-[var(--color-primary)] mb-1 sm:mb-2">{f.title}</h3>
            <p class="text-xs sm:text-sm text-[var(--color-text-light)]">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4 Steps -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
    <div class="text-center mb-8 sm:mb-12">
      <p class="text-[var(--color-accent)] font-medium text-xs sm:text-sm tracking-widest uppercase mb-2">How It Works</p>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-[var(--color-primary)]">4 Steps to Order</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-8">
      {STEPS.map((step) => (
        <div class="text-center">
          <div class="w-12 h-12 sm:w-16 sm:h-16 bg-[var(--color-primary)] text-white rounded-full flex items-center justify-center text-base sm:text-xl font-bold mx-auto mb-3 sm:mb-4">{step.num}</div>
          <h3 class="font-bold text-sm sm:text-base text-[var(--color-primary)] mb-1 sm:mb-2">{step.title}</h3>
          <p class="text-xs sm:text-sm text-[var(--color-text-light)]">{step.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Trust / Warehouse Section -->
  <section class="bg-[var(--color-secondary)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
      <div class="text-center mb-8 sm:mb-12">
        <p class="text-[var(--color-accent)] font-medium text-xs sm:text-sm tracking-widest uppercase mb-2">Real Business, Real Stock</p>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-[var(--color-primary)]">See Our Warehouse</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6">
        <div class="bg-white rounded-xl sm:rounded-2xl overflow-hidden border border-[var(--color-border)] hover:shadow-md transition-shadow">
          <div class="aspect-video rounded-t-xl sm:rounded-t-2xl overflow-hidden">
            <img src="/images/warehouse-stock.jpg" alt="Warehouse Stock" class="w-full h-full object-cover" />
          </div>
          <div class="p-4 sm:p-5">
            <h3 class="font-bold text-sm sm:text-base text-[var(--color-text)]">50,000+ PCS Ready Stock</h3>
            <p class="text-xs sm:text-sm text-[var(--color-text-light)] mt-1">Real inventory, not dropship fantasy</p>
          </div>
        </div>
        <div class="bg-white rounded-xl sm:rounded-2xl overflow-hidden border border-[var(--color-border)] hover:shadow-md transition-shadow">
          <div class="aspect-video rounded-t-xl sm:rounded-t-2xl overflow-hidden">
            <img src="/images/quality-control.webp" alt="Quality Control" class="w-full h-full object-cover" />
          </div>
          <div class="p-4 sm:p-5">
            <h3 class="font-bold text-sm sm:text-base text-[var(--color-text)]">Strict QC Process</h3>
            <p class="text-xs sm:text-sm text-[var(--color-text-light)] mt-1">Every piece inspected before shipping</p>
          </div>
        </div>
        <div class="bg-white rounded-xl sm:rounded-2xl overflow-hidden border border-[var(--color-border)] hover:shadow-md transition-shadow">
          <div class="aspect-video rounded-t-xl sm:rounded-t-2xl overflow-hidden">
            <img src="/images/fast-shipping.jpg" alt="Fast Shipping" class="w-full h-full object-cover" />
          </div>
          <div class="p-4 sm:p-5">
            <h3 class="font-bold text-sm sm:text-base text-[var(--color-text)]">Same-Day Dispatch</h3>
            <p class="text-xs sm:text-sm text-[var(--color-text-light)] mt-1">Order before 2PM, ships same day</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
    <div class="text-center mb-8 sm:mb-12">
      <p class="text-[var(--color-accent)] font-medium text-xs sm:text-sm tracking-widest uppercase mb-2">Customer Reviews</p>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-[var(--color-primary)]">Trusted by 500+ Sellers</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-8">
      {TESTIMONIALS.map((t) => (
        <div class="bg-white border border-[var(--color-border)] rounded-xl sm:rounded-2xl p-5 sm:p-8 hover:shadow-md transition-shadow">
          <div class="flex gap-1 mb-3 sm:mb-4">
            {Array.from({ length: t.rating }).map(() => (
              <svg class="w-4 h-4 sm:w-5 sm:h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <p class="text-[var(--color-text-light)] text-xs sm:text-sm leading-relaxed italic mb-4 sm:mb-6">"{t.text}"</p>
          <div class="flex items-center gap-3">
            <img src={t.avatar} alt={t.name} class="w-10 h-10 sm:w-20 sm:h-20 rounded-full object-cover" />
            <div>
              <p class="font-semibold text-[var(--color-text)] text-xs sm:text-sm">{t.name}</p>
              <p class="text-[10px] sm:text-xs text-[var(--color-text-light)]">{t.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-[var(--color-primary)] text-white">
    <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 py-12 sm:py-16 text-center">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-3 sm:mb-4">Ready to Start Your Activewear Business?</h2>
      <p class="text-sm sm:text-base text-gray-300 mb-6 sm:mb-8 max-w-xl mx-auto">Get instant quote via WhatsApp. Response within 30 minutes during business hours.</p>
      <a
        href={SITE.whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 bg-[var(--color-whatsapp)] text-white px-8 sm:px-10 py-3.5 sm:py-4 rounded-full font-semibold text-base sm:text-lg hover:bg-green-600 transition-colors"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.5.5 0 00.611.611l4.458-1.495A11.952 11.952 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-2.387 0-4.607-.795-6.392-2.135l-.446-.345-3.22 1.079 1.079-3.22-.345-.446A9.935 9.935 0 012 12C2 6.486 6.486 2 12 2s10 4.486 10 10-4.486 10-10 10z"/></svg>
        WhatsApp Us Now
      </a>
    </div>
  </section>

  <!-- WebSite Schema with SearchAction -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "WholesaleYoga - Activewear Factory Direct",
    "url": SITE.url,
    "potentialAction": {
      "@type": "SearchAction",
      "target": `${SITE.url}/products?q={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  })} />

  <!-- WholesaleStore Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WholesaleStore",
    "name": "WholesaleYoga",
    "description": "Factory direct activewear wholesale. Low MOQ 30-50pcs, fast shipping 3-7 days, custom logo service. 300+ in-stock styles.",
    "url": SITE.url,
    "telephone": "+8615556105390",
    "email": "info@yogabulk.com",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Hefei",
      "addressRegion": "Anhui",
      "addressCountry": "CN"
    },
    "openingHours": "Mo-Fr 09:00-18:00",
    "priceRange": "$$"
  })} />

  <!-- BreadcrumbList Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url},
      {"@type": "ListItem", "position": 2, "name": "Products", "item": `${SITE.url}/products/`}
    ]
  })} />

  <!-- FAQ Section (front-end visible + schema aligned) -->
  <section class="bg-[var(--color-secondary)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">
      <div class="text-center mb-8 sm:mb-12">
        <p class="text-[var(--color-accent)] font-medium text-xs sm:text-sm tracking-widest uppercase mb-2">Common Questions</p>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-[var(--color-primary)]">FAQ</h2>
      </div>
      <div class="max-w-3xl mx-auto flex flex-col gap-3">
        {HOME_FAQS.map(faq => (<details class="bg-white border border-[var(--color-border)] rounded-xl overflow-hidden group">
          <summary class="flex items-center justify-between p-4 sm:p-5 cursor-pointer list-none gap-4">
            <span class="font-semibold text-sm sm:text-base text-[var(--color-text)]">{faq.q}</span>
            <svg class="w-5 h-5 text-[var(--color-text-light)] flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-4 sm:px-5 pb-4 sm:pb-5 text-sm text-[var(--color-text-light)] leading-relaxed border-t border-[var(--color-border)] pt-3">{faq.a}</div>
        </details>))}
      </div>
      <div class="text-center mt-8">
        <a href="/faq/" class="inline-block border-2 border-[var(--color-primary)] text-[var(--color-primary)] px-6 py-3 rounded-full font-semibold text-sm hover:bg-[var(--color-primary)] hover:text-white transition-colors">View All FAQ →</a>
      </div>
    </div>
  </section>

  <!-- FAQPage Schema (8 items, aligned with visible FAQ section) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": HOME_FAQS.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a
      }
    }))
  })} />

  <!-- Internal Links Section -->
  <InternalLinks pageType="home" />
</BaseLayout>

