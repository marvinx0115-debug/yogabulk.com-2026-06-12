---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedResources from "../../components/RelatedResources.astro";
import { allPricing, pricingTiers, shippingCosts, calculateShipping } from "../../data/pricing";

const title = "Wholesale Activewear Pricing 2025 | Volume Discounts";
const description = "Wholesale activewear pricing with volume discounts. Seamless leggings from $5.10/pc at 1000pcs. Sports bras from $4.13/pc. Matching sets from $9.00/pc. Get instant quote.";
---

<BaseLayout title={title} description={description}>
  <main class="max-w-7xl mx-auto px-4 py-12">
    <!-- Hero -->
    <section class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-gray-900">
        Wholesale Pricing 2025
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Transparent factory-direct pricing with volume discounts. 
        The more you order, the more you save.
      </p>
    </section>

    <!-- Quick Stats -->
    <section class="grid md:grid-cols-4 gap-4 mb-12">
      <div class="bg-blue-50 rounded-xl p-6 text-center">
        <div class="text-3xl font-bold text-blue-600">$5.10</div>
        <div class="text-sm text-gray-600">Leggings at 1000pcs</div>
      </div>
      <div class="bg-purple-50 rounded-xl p-6 text-center">
        <div class="text-3xl font-bold text-purple-600">25%</div>
        <div class="text-sm text-gray-600">Max Volume Discount</div>
      </div>
      <div class="bg-green-50 rounded-xl p-6 text-center">
        <div class="text-3xl font-bold text-green-600">3-7</div>
        <div class="text-sm text-gray-600">Days Shipping</div>
      </div>
      <div class="bg-orange-50 rounded-xl p-6 text-center">
        <div class="text-3xl font-bold text-orange-600">30</div>
        <div class="text-sm text-gray-600">Pieces MOQ</div>
      </div>
    </section>

    <!-- Pricing Tables -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold mb-8 text-gray-900">Volume Pricing by Category</h2>
      
      {allPricing.map((product) => (
        <div class="bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden mb-8">
          <div class="bg-gradient-to-r from-blue-600 to-purple-600 text-white p-6">
            <h3 class="text-xl font-bold">{product.category}</h3>
            <p class="text-blue-100">Base price: ${product.basePrice.toFixed(2)}/pc</p>
          </div>
          
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">Quantity</th>
                  <th class="px-6 py-4 text-center text-sm font-semibold text-gray-900">Discount</th>
                  <th class="px-6 py-4 text-center text-sm font-semibold text-gray-900">Unit Price</th>
                  <th class="px-6 py-4 text-center text-sm font-semibold text-gray-900">Total Price</th>
                  <th class="px-6 py-4 text-center text-sm font-semibold text-gray-900">You Save</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                {product.tiers.map((tier, index) => (
                  <tr class={index === 4 ? "bg-green-50" : "hover:bg-gray-50"}>
                    <td class="px-6 py-4">
                      <span class="font-bold text-gray-900">{tier.quantity} pcs</span>
                      {index === 4 && <span class="ml-2 text-xs bg-green-500 text-white px-2 py-1 rounded">Best Value</span>}
                    </td>
                    <td class="px-6 py-4 text-center">
                      <span class="inline-block bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">
                        {tier.savingsPercent} OFF
                      </span>
                    </td>
                    <td class="px-6 py-4 text-center">
                      <span class="text-lg font-bold text-gray-900">${tier.unitPrice.toFixed(2)}</span>
                      <span class="text-sm text-gray-500">/pc</span>
                    </td>
                    <td class="px-6 py-4 text-center">
                      <span class="font-medium text-gray-900">${tier.totalPrice.toLocaleString()}</span>
                    </td>
                    <td class="px-6 py-4 text-center">
                      <span class="text-green-600 font-medium">${tier.savings.toLocaleString()}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
    </section>

    <!-- Shipping Costs -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold mb-8 text-gray-900">Shipping Costs by Region</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {Object.entries(shippingCosts).map(([region, costs]) => (
          <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">
            <h3 class="text-lg font-bold text-gray-900 mb-4 capitalize">{region === "usa" ? "USA" : region === "uk" ? "UK" : region === "eu" ? "Europe" : region === "australia" ? "Australia" : "Canada"}</h3>
            <div class="space-y-3">
              <div class="flex justify-between items-center py-2 border-b border-gray-100">
                <div>
                  <div class="font-medium text-gray-900">{costs.express.name}</div>
                  <div class="text-sm text-gray-500">{costs.express.days} days</div>
                </div>
                <div class="text-right">
                  <div class="font-bold text-blue-600">${costs.express.costPerKg}/kg</div>
                </div>
              </div>
              <div class="flex justify-between items-center py-2 border-b border-gray-100">
                <div>
                  <div class="font-medium text-gray-900">{costs.standard.name}</div>
                  <div class="text-sm text-gray-500">{costs.standard.days} days</div>
                </div>
                <div class="text-right">
                  <div class="font-bold text-gray-700">${costs.standard.costPerKg}/kg</div>
                </div>
              </div>
              <div class="flex justify-between items-center py-2">
                <div>
                  <div class="font-medium text-gray-900">{costs.sea.name}</div>
                  <div class="text-sm text-gray-500">{costs.sea.days} days</div>
                </div>
                <div class="text-right">
                  <div class="font-bold text-gray-700">${costs.sea.costPerKg}/kg</div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <p class="text-sm text-gray-500 mt-4">
        * Shipping costs are estimates based on weight. Actual costs may vary depending on package dimensions and current fuel surcharges.
      </p>
    </section>

    <!-- Price Calculator -->
    <section class="bg-gradient-to-r from-blue-50 to-purple-50 rounded-2xl p-8 mb-16">
      <h2 class="text-2xl font-bold mb-6 text-gray-900">Quick Price Calculator</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Product Category</label>
          <select id="calcCategory" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            {allPricing.map(p => (
              <option value={p.basePrice}>{p.category}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Quantity</label>
          <input 
            type="number" 
            id="calcQuantity" 
            min="30" 
            value="100"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Estimated Total</label>
          <div id="calcResult" class="text-3xl font-bold text-blue-600 py-2">
            $612.00
          </div>
          <div id="calcDetails" class="text-sm text-gray-600">
            $6.12/pc • 10% discount
          </div>
        </div>
      </div>
    </section>

    <!-- Why Our Pricing -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold mb-8 text-gray-900 text-center">Why Our Pricing Works</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-3xl">🏭</span>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Factory Direct</h3>
          <p class="text-gray-600 text-sm">No middlemen. You buy directly from our manufacturing facility, cutting out 2-3 layers of markup.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-3xl">📦</span>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Ready Stock</h3>
          <p class="text-gray-600 text-sm">50,000+ pieces in stock means no production delays. Order today, ship this week.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-3xl">🎨</span>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Mix & Match</h3>
          <p class="text-gray-600 text-sm">Combine colors and sizes within the same style to meet MOQ. No need to commit to one variant.</p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gray-900 text-white rounded-2xl p-8 md:p-12 text-center">
      <h2 class="text-3xl font-bold mb-4">Get Your Custom Quote</h2>
      <p class="text-lg mb-6 text-gray-300 max-w-2xl mx-auto">
        Prices above are estimates. Contact us for exact pricing based on your specific selection, shipping destination, and any customization needs.
      </p>
      <a 
        href="https://wa.me/8615556105390?text=Hi,%20I%20need%20a%20pricing%20quote"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-green-500 text-white px-8 py-4 rounded-xl font-semibold hover:bg-green-600 transition shadow-lg"
      >
        💬 Get Instant Quote on WhatsApp
      </a>
    </section>
  </main>

  <RelatedResources currentPage="data" />

  <!-- Dataset Schema -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Dataset",
      "name": "Wholesale Activewear Pricing 2025",
      "description": "Factory-direct wholesale pricing for activewear with volume discounts. Includes pricing tiers for seamless leggings, sports bras, matching sets, jumpsuits, and gym shorts.",
      "url": "https://yogabulk-backup.pages.dev/data/yoga-leggings-wholesale-pricing/",
      "creator": {
        "@type": "Organization",
        "name": "YogaBulk"
      },
      "datePublished": "2025-01-01",
      "dateModified": "2025-06-01",
      "license": "https://yogabulk-backup.pages.dev/terms",
      "distribution": {
        "@type": "DataDownload",
        "contentUrl": "https://yogabulk-backup.pages.dev/data/yoga-leggings-wholesale-pricing/",
        "encodingFormat": "HTML"
      },
      "variableMeasured": [
        "Unit Price",
        "Volume Discount",
        "Total Order Value",
        "Shipping Cost"
      ]
    }
  </script>

  <!-- Calculator Script -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const categorySelect = document.getElementById('calcCategory');
      const quantityInput = document.getElementById('calcQuantity');
      const resultDiv = document.getElementById('calcResult');
      const detailsDiv = document.getElementById('calcDetails');

      function calculate() {
        const basePrice = parseFloat(categorySelect?.value || 6.80);
        const quantity = parseInt(quantityInput?.value || 100);

        let discount = 0;
        if (quantity >= 1000) discount = 0.25;
        else if (quantity >= 500) discount = 0.20;
        else if (quantity >= 300) discount = 0.15;
        else if (quantity >= 100) discount = 0.10;
        else if (quantity >= 50) discount = 0.05;

        const unitPrice = basePrice * (1 - discount);
        const total = unitPrice * quantity;
        const savings = (basePrice - unitPrice) * quantity;

        if (resultDiv) {
          resultDiv.textContent = '$' + total.toFixed(2);
        }
        if (detailsDiv) {
          detailsDiv.textContent = '$' + unitPrice.toFixed(2) + '/pc • ' + Math.round(discount * 100) + '% discount • Save $' + savings.toFixed(2);
        }
      }

      categorySelect?.addEventListener('change', calculate);
      quantityInput?.addEventListener('input', calculate);
    });
  </script>
</BaseLayout>
