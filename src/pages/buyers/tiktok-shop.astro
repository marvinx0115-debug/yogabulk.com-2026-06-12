---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedResources from "../../components/RelatedResources.astro";
import { tiktokCases } from "../../data/caseStudies";

const title = "TikTok Shop Wholesale Activewear | Viral Product Supplier";
const description = "Wholesale activewear for TikTok Shop sellers. Viral-ready products, fast shipping, low MOQ 30pcs. 100+ TikTok sellers grew to 100K+ followers with YogaBulk. Start with $400 budget.";
---

<BaseLayout title={title} description={description}>
  <main class="max-w-7xl mx-auto px-4 py-12">
    <!-- Hero -->
    <section class="text-center mb-12">
      <div class="inline-block bg-pink-100 text-pink-800 px-4 py-2 rounded-full text-sm font-medium mb-4">
        📱 #1 for TikTok Shop Sellers
      </div>
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-gray-900">
        TikTok Shop Wholesale Activewear
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Viral-ready activewear that looks amazing on camera. 
        100+ TikTok Shop sellers grew from 0 to 100K+ followers with our products.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <span class="bg-pink-100 text-pink-800 px-4 py-2 rounded-full text-sm font-medium">
          📱 Viral-Ready Products
        </span>
        <span class="bg-purple-100 text-purple-800 px-4 py-2 rounded-full text-sm font-medium">
          🎥 Camera-Optimized
        </span>
        <span class="bg-blue-100 text-blue-800 px-4 py-2 rounded-full text-sm font-medium">
          ⚡ Fast Restocking
        </span>
      </div>
    </section>

    <!-- Why TikTok Sellers Choose Us -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold mb-8 text-gray-900 text-center">Why TikTok Shop Sellers Choose YogaBulk</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white rounded-xl shadow-md p-6 border border-gray-100">
          <div class="w-12 h-12 bg-pink-100 rounded-lg flex items-center justify-center mb-4">
            <span class="text-2xl">📱</span>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Viral-Ready Products</h3>
          <p class="text-gray-600 text-sm">Our honeycomb leggings and scrunch butt styles are proven viral hits. The textures and colors pop on camera.</p>
        </div>
        <div class="bg-white rounded-xl shadow-md p-6 border border-gray-100">
          <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
            <span class="text-2xl">🎥</span>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Camera-Optimized</h3>
          <p class="text-gray-600 text-sm">Products selected specifically for how they look in TikTok videos. High contrast colors, interesting textures.</p>
        </div>
        <div class="bg-white rounded-xl shadow-md p-6 border border-gray-100">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
            <span class="text-2xl">⚡</span>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Scale When You Go Viral</h3>
          <p class="text-gray-600 text-sm">Start with 50pcs. When your video hits 1M views, we can ship 5000pcs within a week. Never miss a viral moment.</p>
        </div>
        <div class="bg-white rounded-xl shadow-md p-6 border border-gray-100">
          <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mb-4">
            <span class="text-2xl">💰</span>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Low Entry Cost</h3>
          <p class="text-gray-600 text-sm">Start with just $400. Test multiple styles to find what resonates with your audience before scaling.</p>
        </div>
        <div class="bg-white rounded-xl shadow-md p-6 border border-gray-100">
          <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center mb-4">
            <span class="text-2xl">📦</span>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">TikTok Shop Integration</h3>
          <p class="text-gray-600 text-sm">We understand TikTok Shop requirements. Proper labeling and packaging for smooth fulfillment.</p>
        </div>
        <div class="bg-white rounded-xl shadow-md p-6 border border-gray-100">
          <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center mb-4">
            <span class="text-2xl">🚀</span>
          </div>
          <h3 class="font-bold text-gray-900 mb-2">Trend Forecasting</h3>
          <p class="text-gray-600 text-sm">We monitor TikTok trends and stock what's about to go viral. Be first to market with trending styles.</p>
        </div>
      </div>
    </section>

    <!-- Viral Products -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold mb-8 text-gray-900">Products That Go Viral on TikTok</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-200">
          <div class="aspect-square bg-gray-100 relative">
            <div class="absolute top-2 right-2 bg-red-500 text-white px-2 py-1 rounded text-xs font-bold">
              🔥 2M+ views
            </div>
          </div>
          <div class="p-4">
            <h3 class="font-bold text-gray-900 mb-1">Honeycomb Leggings</h3>
            <p class="text-sm text-gray-600 mb-2">The texture that broke TikTok</p>
            <div class="flex justify-between items-center">
              <span class="text-blue-600 font-bold">$4.80-7.20</span>
              <span class="text-xs text-gray-500">MOQ 30</span>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-200">
          <div class="aspect-square bg-gray-100 relative">
            <div class="absolute top-2 right-2 bg-purple-500 text-white px-2 py-1 rounded text-xs font-bold">
              📱 1.5M+ views
            </div>
          </div>
          <div class="p-4">
            <h3 class="font-bold text-gray-900 mb-1">Scrunch Butt Leggings</h3>
            <p class="text-sm text-gray-600 mb-2">The viral "booty" leggings</p>
            <div class="flex justify-between items-center">
              <span class="text-blue-600 font-bold">$5.20-7.50</span>
              <span class="text-xs text-gray-500">MOQ 30</span>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-200">
          <div class="aspect-square bg-gray-100 relative">
            <div class="absolute top-2 right-2 bg-pink-500 text-white px-2 py-1 rounded text-xs font-bold">
              💃 800K+ views
            </div>
          </div>
          <div class="p-4">
            <h3 class="font-bold text-gray-900 mb-1">Flare Yoga Pants</h3>
            <p class="text-sm text-gray-600 mb-2">70s revival trend</p>
            <div class="flex justify-between items-center">
              <span class="text-blue-600 font-bold">$6.50-9.50</span>
              <span class="text-xs text-gray-500">MOQ 30</span>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-200">
          <div class="aspect-square bg-gray-100 relative">
            <div class="absolute top-2 right-2 bg-blue-500 text-white px-2 py-1 rounded text-xs font-bold">
              ✨ 600K+ views
            </div>
          </div>
          <div class="p-4">
            <h3 class="font-bold text-gray-900 mb-1">Matching Sets</h3>
            <p class="text-sm text-gray-600 mb-2">Complete outfit in one</p>
            <div class="flex justify-between items-center">
              <span class="text-blue-600 font-bold">$8.50-12.00</span>
              <span class="text-xs text-gray-500">MOQ 20</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Success Stories -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold mb-8 text-gray-900">TikTok Shop Success Stories</h2>
      <div class="space-y-8">
        {tiktokCases.map((story) => (
          <div class="bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden">
            <div class="grid md:grid-cols-3 gap-0">
              <div class="bg-gradient-to-br from-pink-500 to-purple-600 text-white p-8 flex flex-col justify-center">
                <div class="text-4xl font-bold mb-2">{story.currentVolume}</div>
                <div class="text-pink-100 mb-4">Current Volume</div>
                <div class="text-sm text-pink-100">Started: {story.startedWith}</div>
                <div class="text-sm text-pink-100">Timeline: {story.timeline}</div>
              </div>
              <div class="md:col-span-2 p-8">
                <div class="flex items-center gap-4 mb-4">
                  <div class="w-12 h-12 bg-gray-200 rounded-full"></div>
                  <div>
                    <h3 class="font-bold text-gray-900">{story.name}</h3>
                    <p class="text-sm text-gray-600">{story.businessType} • {story.location}</p>
                  </div>
                </div>
                <blockquote class="text-gray-700 italic mb-4">"{story.testimonial}"</blockquote>
                <div class="grid grid-cols-2 gap-4">
                  {story.results.slice(0, 4).map((result) => (
                    <div class="flex items-center gap-2">
                      <span class="text-green-500">✓</span>
                      <span class="text-sm text-gray-700">{result}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- TikTok Shop Startup Budget -->
    <section class="bg-gradient-to-r from-pink-50 to-purple-50 rounded-2xl p-8 mb-16">
      <h2 class="text-2xl font-bold mb-6 text-gray-900">TikTok Shop Startup Budget</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="font-bold text-gray-900 mb-4">First Order (Test Phase - 50pcs)</h3>
          <div class="space-y-3">
            <div class="flex justify-between items-center py-2 border-b border-gray-200">
              <span class="text-gray-600">Product Cost (50pcs @ $6.46)</span>
              <span class="font-medium">$323</span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-gray-200">
              <span class="text-gray-600">Shipping (Express)</span>
              <span class="font-medium">$45</span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-gray-200">
              <span class="text-gray-600">Customs/Duties</span>
              <span class="font-medium">$25</span>
            </div>
            <div class="flex justify-between items-center py-3 font-bold text-lg">
              <span class="text-gray-900">Total First Order</span>
              <span class="text-pink-600">$393</span>
            </div>
          </div>
          <div class="mt-4 bg-green-100 rounded-lg p-4">
            <div class="flex justify-between items-center">
              <span class="text-green-800 font-medium">Expected Revenue (50pcs @ $25)</span>
              <span class="text-green-800 font-bold">$1,250</span>
            </div>
            <div class="flex justify-between items-center mt-2">
              <span class="text-green-800 font-medium">Net Profit (after TikTok fees ~15%)</span>
              <span class="text-green-800 font-bold">$670</span>
            </div>
          </div>
        </div>
        <div>
          <h3 class="font-bold text-gray-900 mb-4">Scaling Budget (Viral Phase - 200pcs)</h3>
          <div class="space-y-3">
            <div class="flex justify-between items-center py-2 border-b border-gray-200">
              <span class="text-gray-600">Product Cost (200pcs @ $6.12)</span>
              <span class="font-medium">$1,224</span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-gray-200">
              <span class="text-gray-600">Shipping (Express)</span>
              <span class="font-medium">$85</span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-gray-200">
              <span class="text-gray-600">Customs/Duties</span>
              <span class="font-medium">$65</span>
            </div>
            <div class="flex justify-between items-center py-3 font-bold text-lg">
              <span class="text-gray-900">Total Order</span>
              <span class="text-pink-600">$1,374</span>
            </div>
          </div>
          <div class="mt-4 bg-green-100 rounded-lg p-4">
            <div class="flex justify-between items-center">
              <span class="text-green-800 font-medium">Expected Revenue (200pcs @ $25)</span>
              <span class="text-green-800 font-bold">$5,000</span>
            </div>
            <div class="flex justify-between items-center mt-2">
              <span class="text-green-800 font-medium">Net Profit (after TikTok fees ~15%)</span>
              <span class="text-green-800 font-bold">$2,876</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- How to Create Viral TikTok Content -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold mb-8 text-gray-900">How to Create Viral TikTok Content</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white rounded-xl shadow-md p-6 border border-gray-200">
          <h3 class="font-bold text-gray-900 mb-4">🎬 Video Formats That Work</h3>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <span class="text-pink-500 font-bold">1</span>
              <div>
                <span class="font-medium">Before/After Transformations</span>
                <p class="text-sm text-gray-600">Show how the leggings enhance the figure</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-pink-500 font-bold">2</span>
              <div>
                <span class="font-medium">Squat Test Videos</span>
                <p class="text-sm text-gray-600">Prove they're squat-proof with dramatic lighting</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-pink-500 font-bold">3</span>
              <div>
                <span class="font-medium">Texture Close-ups</span>
                <p class="text-sm text-gray-600">Honeycomb and ribbed textures perform well</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-pink-500 font-bold">4</span>
              <div>
                <span class="font-medium">Color Comparison</span>
                <p class="text-sm text-gray-600">Show all available colors in one video</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-pink-500 font-bold">5</span>
              <div>
                <span class="font-medium">Workout Transitions</span>
                <p class="text-sm text-gray-600">Quick cuts between exercises</p>
              </div>
            </li>
          </ul>
        </div>
        <div class="bg-white rounded-xl shadow-md p-6 border border-gray-200">
          <h3 class="font-bold text-gray-900 mb-4">💡 Pro Tips for TikTok Shop</h3>
          <ul class="space-y-3">
            <li class="flex items-start gap-2">
              <span class="text-green-500">✓</span>
              <span>Post 3-5 videos per day to increase viral chances</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-500">✓</span>
              <span>Use trending sounds and hashtags (#leggings #activewear)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-500">✓</span>
              <span>Reply to comments with video responses</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-500">✓</span>
              <span>Go live 3x per week to boost sales</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-500">✓</span>
              <span>Pin your best-performing video to profile</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-500">✓</span>
              <span>Always link products in video descriptions</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- How to Start -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold mb-8 text-gray-900 text-center">How to Start Selling on TikTok Shop</h2>
      <div class="grid md:grid-cols-5 gap-4">
        <div class="text-center">
          <div class="w-16 h-16 bg-pink-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">1</div>
          <h3 class="font-bold text-gray-900 mb-2">Apply for TikTok Shop</h3>
          <p class="text-sm text-gray-600">Sign up at seller.tiktok.com. Verify your business.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-pink-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">2</div>
          <h3 class="font-bold text-gray-900 mb-2">Order Viral Products</h3>
          <p class="text-sm text-gray-600">Start with honeycomb leggings or scrunch butt styles.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-pink-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">3</div>
          <h3 class="font-bold text-gray-900 mb-2">Create Content</h3>
          <p class="text-sm text-gray-600">Film 10-20 videos showcasing the products.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-pink-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">4</div>
          <h3 class="font-bold text-gray-900 mb-2">Post & Engage</h3>
          <p class="text-sm text-gray-600">Post 3-5x daily. Reply to every comment.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-pink-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">5</div>
          <h3 class="font-bold text-gray-900 mb-2">Scale When Viral</h3>
          <p class="text-sm text-gray-600">When a video hits 100K views, order more stock immediately.</p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-gradient-to-r from-pink-500 to-purple-500 text-white rounded-2xl p-8 md:p-12 text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to Go Viral?</h2>
      <p class="text-lg mb-6 opacity-90 max-w-2xl mx-auto">
        Join 100+ TikTok Shop sellers who grew from 0 to 100K+ followers. 
        Start with just $400 and the right viral products.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="https://wa.me/8615556105390?text=Hi,%20I'm%20a%20TikTok%20Shop%20seller%20and%20want%20viral%20products"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-white text-pink-600 px-8 py-4 rounded-xl font-semibold hover:bg-gray-100 transition shadow-lg"
        >
          💬 Get Viral Products
        </a>
        <a 
          href="/inventory/" 
          class="inline-block bg-pink-600 text-white px-8 py-4 rounded-xl font-semibold hover:bg-pink-700 transition border-2 border-pink-400"
        >
          Browse Inventory
        </a>
      </div>
    </section>
  </main>

  <RelatedResources currentPage="buyer" />

  <!-- Schema -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "TikTok Shop Wholesale Activewear Guide 2025",
      "description": "Complete guide for TikTok Shop sellers looking to source viral-ready wholesale activewear. Includes startup budget, viral products, and success stories.",
      "url": "https://yogabulk-backup.pages.dev/buyers/tiktok-shop/",
      "author": {
        "@type": "Organization",
        "name": "YogaBulk"
      },
      "publisher": {
        "@type": "Organization",
        "name": "YogaBulk",
        "logo": {
          "@type": "ImageObject",
          "url": "https://yogabulk-backup.pages.dev/favicon.svg"
        }
      },
      "datePublished": "2025-01-01",
      "dateModified": "2025-06-01"
    }
  </script>
</BaseLayout>
