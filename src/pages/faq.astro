---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, FAQS, FAQ_CATEGORIES, FAQ_CATEGORY_NUMBERS, FAQ_PRODUCT, FAQ_SELLERS, FAQ_BUSINESS } from '../data/site';
const categories = FAQ_CATEGORIES;
const faqByCategory = categories.map(cat => ({
  category: cat,
  items: FAQS.filter(f => f.category === cat),
})).filter(g => g.items.length > 0);
const catNum = FAQ_CATEGORY_NUMBERS;
---
<BaseLayout title="FAQ" description="Frequently asked questions about wholesale activewear ordering. MOQ, shipping, custom logo, payment methods, samples, and more.">
  <section style="background-color:var(--color-primary);color:white;">
    <div style="max-width:56rem;margin:0 auto;padding:4rem 1.5rem;text-align:center;">
      <p style="color:var(--color-accent-light);font-weight:500;font-size:0.875rem;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.5rem;">Got Questions?</p>
      <h1 style="font-size:2.5rem;font-weight:800;margin-bottom:1rem;">FAQ</h1>
      <p style="color:#d1d5db;max-width:42rem;margin:0 auto;">Everything you need to know about ordering from Wholesale Yoga.</p>
    </div>
  </section>
  <div style="max-width:56rem;margin:-2rem auto 1.5rem;padding:0 1.5rem;">
    <div style="background:white;border-radius:1rem;box-shadow:0 10px 15px -3px rgba(0,0,0,0.1);border:1px solid var(--color-border);padding:1rem;display:flex;align-items:center;gap:0.75rem;">
      <svg style="width:1.25rem;height:1.25rem;color:var(--color-text-light);flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      <input type="text" id="faq-search" placeholder="Search questions..." style="flex:1;font-size:0.875rem;outline:none;border:none;" />
      <span id="search-count" class="hidden" style="font-size:0.75rem;color:var(--color-text-light);"></span>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-top:0.75rem;" id="cat-tabs">
      <button class="cat-tab active" data-cat="all" style="padding:0.5rem 1rem;border-radius:9999px;font-size:0.75rem;font-weight:600;cursor:pointer;border:none;background-color:var(--color-primary);color:white;">All</button>
      {categories.map(cat => (<button class="cat-tab" data-cat={cat} style="padding:0.5rem 1rem;border-radius:9999px;font-size:0.75rem;font-weight:600;cursor:pointer;border:none;background-color:var(--color-secondary);color:var(--color-text-light);">{cat}</button>))}
    </div>
  </div>
  <section style="max-width:56rem;margin:0 auto;padding:0 1.5rem 4rem;">
    {faqByCategory.map(group => (<div class="faq-group" data-cat={group.category} style="margin-bottom:2.5rem;">
      <h2 style="font-size:0.875rem;font-weight:700;color:var(--color-primary);margin-bottom:0.75rem;display:flex;align-items:center;gap:0.5rem;text-transform:uppercase;letter-spacing:0.05em;">
        <span style="width:1.5rem;height:1.5rem;border-radius:0.375rem;background-color:var(--color-primary);color:white;font-size:0.75rem;font-weight:700;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">{catNum[group.category]}</span>
        {group.category}
      </h2>
      <div style="display:flex;flex-direction:column;gap:0.5rem;">
        {group.items.map(faq => (<details style="background:white;border:1px solid var(--color-border);border-radius:0.75rem;overflow:hidden;">
          <summary style="display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;cursor:pointer;list-style:none;gap:1rem;">
            <span style="font-weight:600;color:var(--color-text);">{faq.q}</span>
            <svg style="width:1.25rem;height:1.25rem;color:var(--color-text-light);flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div style="padding:0 1.25rem 1.25rem;font-size:0.875rem;color:var(--color-text-light);line-height:1.75;border-top:1px solid var(--color-border);padding-top:0.75rem;">{faq.a}</div>
        </details>))}
      </div>
    </div>))}
    <div id="no-results" style="text-align:center;padding:3rem 0;display:none;">
      <p style="color:var(--color-text-light);margin-bottom:0.75rem;">No questions match your search.</p>
      <a href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:0.5rem;background-color:var(--color-whatsapp);color:white;padding:0.75rem 1.5rem;border-radius:9999px;font-weight:600;font-size:0.875rem;">Ask on WhatsApp</a>
    </div>
  </section>
  <div style="max-width:56rem;margin:0 auto;padding:0 1.5rem 2rem;">
    <h2 style="font-size:1.25rem;font-weight:700;color:var(--color-primary);margin-bottom:1rem;text-align:center;">More FAQ Topics</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;">
      <a href="/faq/product-knowledge/" style="display:block;background:white;border:1px solid var(--color-border);border-radius:1rem;padding:1.25rem;text-decoration:none;transition:box-shadow 0.2s;" onmouseover="this.style.boxShadow='0 4px 12px rgba(0,0,0,0.1)'" onmouseout="this.style.boxShadow='none'">
        <div style="font-size:1.5rem;margin-bottom:0.5rem;">🧪</div>
        <div style="font-weight:700;color:var(--color-text);margin-bottom:0.25rem;">Product Knowledge</div>
        <div style="font-size:0.8rem;color:var(--color-text-light);">Fabric, sizing, care & quality — 22 questions</div>
      </a>
      <a href="/faq/sellers-guide/" style="display:block;background:white;border:1px solid var(--color-border);border-radius:1rem;padding:1.25rem;text-decoration:none;transition:box-shadow 0.2s;" onmouseover="this.style.boxShadow='0 4px 12px rgba(0,0,0,0.1)'" onmouseout="this.style.boxShadow='none'">
        <div style="font-size:1.5rem;margin-bottom:0.5rem;">🛒</div>
        <div style="font-weight:700;color:var(--color-text);margin-bottom:0.25rem;">Sellers Guide</div>
        <div style="font-size:0.8rem;color:var(--color-text-light);">Amazon FBA, TikTok Shop & more — 24 questions</div>
      </a>
      <a href="/faq/business-guide/" style="display:block;background:white;border:1px solid var(--color-border);border-radius:1rem;padding:1.25rem;text-decoration:none;transition:box-shadow 0.2s;" onmouseover="this.style.boxShadow='0 4px 12px rgba(0,0,0,0.1)'" onmouseout="this.style.boxShadow='none'">
        <div style="font-size:1.5rem;margin-bottom:0.5rem;">💼</div>
        <div style="font-weight:700;color:var(--color-text);margin-bottom:0.25rem;">Business Guide</div>
        <div style="font-size:0.8rem;color:var(--color-text-light);">Compliance, operations & trends — 24 questions</div>
      </a>
    </div>
  </div>
  <div style="max-width:56rem;margin:0 auto;padding:0 1.5rem 4rem;">
    <div style="background-color:var(--color-secondary);border-radius:1.5rem;padding:2rem;text-align:center;">
      <h2 style="font-size:1.5rem;font-weight:700;color:var(--color-primary);margin-bottom:0.75rem;">Still Have Questions?</h2>
      <p style="font-size:0.875rem;color:var(--color-text-light);margin-bottom:1.5rem;">Get instant answers on WhatsApp. We respond within 30 minutes.</p>
      <a href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:0.5rem;background-color:var(--color-whatsapp);color:white;padding:1rem 2rem;border-radius:9999px;font-weight:600;">Ask on WhatsApp</a>
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "FAQPage",
    "mainEntity": FAQS.map(f => ({
      "@type": "Question", "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a },
    }))
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
      { "@type": "ListItem", "position": 2, "name": "FAQ", "item": SITE.url + "/faq" }
    ]
  })} />

  <script>
    const si = document.getElementById('faq-search');
    const tabs = document.querySelectorAll('.cat-tab');
    const items = document.querySelectorAll('details');
    const groups = document.querySelectorAll('.faq-group');
    const noRes = document.getElementById('no-results');
    const sc = document.getElementById('search-count');
    let activeCat = 'all';
    let term = '';
    function filter() {
      let n = 0;
      const l = term.toLowerCase();
      items.forEach(i => {
        const g = i.closest('.faq-group');
        const show = (!term || i.textContent.toLowerCase().includes(l)) && (activeCat === 'all' || g.dataset.cat === activeCat);
        i.style.display = show ? '' : 'none';
        if (show) n++;
      });
      groups.forEach(g => { g.style.display = (activeCat === 'all' || g.dataset.cat === activeCat) ? '' : 'none'; });
      if (noRes) noRes.style.display = n ? 'none' : 'block';
      if (sc) { sc.classList.toggle('hidden', !term); sc.textContent = n + (n !== 1 ? ' results' : ' result'); }
    }
    si.addEventListener('input', e => { term = e.target.value; filter(); });
    tabs.forEach(t => t.addEventListener('click', () => {
      tabs.forEach(x => { x.style.backgroundColor = 'var(--color-secondary)'; x.style.color = 'var(--color-text-light)'; });
      t.style.backgroundColor = 'var(--color-primary)'; t.style.color = 'white';
      activeCat = t.dataset.cat; filter();
    }));
    items.forEach(item => item.addEventListener('toggle', () => {
      if (item.open) items.forEach(other => { if (other !== item && other.open) other.open = false; });
    }));
  </script>
</BaseLayout>