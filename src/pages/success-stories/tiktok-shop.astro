---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE, WHATSAPP } from "../../data/site";
---
<BaseLayout title="TikTok Shop Merchant Success Story | Viral Video 200K Views" description="How a TikTok Shop merchant turned a viral video into a sustainable activewear business with Wholesale Yoga dropshipping and wholesale.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <!-- Hero -->
    <section class="text-center mb-12">
      <p class="text-[var(--color-accent)] font-medium text-sm tracking-widest uppercase mb-3">Success Story</p>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--color-primary)] mb-4">🎵 James L. — TikTok Shop Seller, UK</h1>
    </section>

    <!-- Stats -->
    <section class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      <div class="bg-gradient-to-br from-pink-50 to-pink-100 rounded-xl p-6 text-center">
        <p class="text-2xl sm:text-3xl font-bold text-[var(--color-accent)]">200K</p>
        <p class="text-sm text-gray-600 mt-1">Video Views</p>
      </div>
      <div class="bg-gradient-to-br from-pink-50 to-pink-100 rounded-xl p-6 text-center">
        <p class="text-2xl sm:text-3xl font-bold text-[var(--color-accent)]">5⭐</p>
        <p class="text-sm text-gray-600 mt-1">Shop Rating</p>
      </div>
      <div class="bg-gradient-to-br from-pink-50 to-pink-100 rounded-xl p-6 text-center">
        <p class="text-2xl sm:text-3xl font-bold text-[var(--color-accent)]">40%</p>
        <p class="text-sm text-gray-600 mt-1">Conversion Rate</p>
      </div>
      <div class="bg-gradient-to-br from-pink-50 to-pink-100 rounded-xl p-6 text-center">
        <p class="text-2xl sm:text-3xl font-bold text-[var(--color-accent)]">3 Days</p>
        <p class="text-sm text-gray-600 mt-1">Fulfillment Time</p>
      </div>
    </section>

    <!-- Quote -->
    <section class="bg-[var(--color-bg-secondary)] rounded-2xl p-8 mb-12 border-l-4 border-[var(--color-primary)]">
      <blockquote class="text-lg italic text-[var(--color-text-secondary)]">
        "Low MOQ is a game changer. I can test new styles without risking thousands. Their seamless leggings went viral on my TikTok — 200K views and I sold out in 3 days."
      </blockquote>
      <p class="mt-4 font-semibold text-[var(--color-text)]">— James L., TikTok Shop Seller, UK</p>
    </section>

    <!-- Challenge -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-4">🔴 The Challenge</h2>
      <p class="text-[var(--color-text-secondary)] leading-relaxed">James launched his TikTok Shop in early 2025 selling fitness apparel but faced two problems: his dropshipping supplier had 10-15 day shipping times (killing TikTok Shop metrics), and product quality was inconsistent. His shop rating dropped to 3.2 stars and TikTok threatened to suspend his seller privileges.</p>
    </section>

    <!-- Solution -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-4">🟢 The Solution</h2>
      <p class="text-[var(--color-text-secondary)] leading-relaxed">He switched to Wholesale Yoga for both dropshipping and bulk orders. Our 3-7 day fulfillment window brought his TikTok Shop shipping metrics back to green. The consistent quality of our seamless leggings and matching sets earned him 5-star reviews. He now orders 200-500 pieces monthly and uses our product photos for his TikTok content.</p>
    </section>

    <!-- Results -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-4">📊 Results</h2>
      <ul class="space-y-3">
        <li class="flex items-start gap-3">
          <span class="text-[var(--color-primary)] mt-1">✓</span>
          <span class="text-[var(--color-text-secondary)]">Shop rating recovered from 3.2 to 5.0 stars within 2 months</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[var(--color-primary)] mt-1">✓</span>
          <span class="text-[var(--color-text-secondary)]">Viral TikTok video with 200K views driving daily organic sales</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[var(--color-primary)] mt-1">✓</span>
          <span class="text-[var(--color-text-secondary)]">40% conversion rate from video viewers to buyers</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[var(--color-primary)] mt-1">✓</span>
          <span class="text-[var(--color-text-secondary)]">Average order fulfillment in 3 business days</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[var(--color-primary)] mt-1">✓</span>
          <span class="text-[var(--color-text-secondary)]">Expanded from dropshipping to bulk orders for better margins</span>
        </li>
      </ul>
    </section>

    <!-- FAQ -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        <details class="bg-[var(--color-bg-secondary)] rounded-lg p-4 cursor-pointer">
          <summary class="font-semibold text-[var(--color-text)]">Can I use TikTok Shop with your wholesale service?</summary>
          <p class="mt-3 text-[var(--color-text-secondary)]">Yes! Many TikTok Shop sellers use us for both dropshipping and bulk orders. Our fast fulfillment helps maintain your shop metrics.</p>
        </details>
        <details class="bg-[var(--color-bg-secondary)] rounded-lg p-4 cursor-pointer">
          <summary class="font-semibold text-[var(--color-text)]">Do you provide product photos for TikTok content?</summary>
          <p class="mt-3 text-[var(--color-text-secondary)]">Yes! All wholesale orders include professional product photos and video-ready lifestyle shots you can use for your TikTok content.</p>
        </details>
        <details class="bg-[var(--color-bg-secondary)] rounded-lg p-4 cursor-pointer">
          <summary class="font-semibold text-[var(--color-text)]">What is the minimum order for TikTok Shop sellers?</summary>
          <p class="mt-3 text-[var(--color-text-secondary)]">Dropshipping orders have no minimum. For bulk orders, MOQ starts at 30-50 pieces per style with mix-and-match colors and sizes.</p>
        </details>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-[var(--color-secondary)] rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold text-[var(--color-primary)] mb-4">Be the Next Success Story</h2>
      <p class="text-gray-600 mb-6">Start with a small test order and scale with confidence.</p>
      <a href={WHATSAPP} target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-[var(--color-whatsapp)] text-white px-8 py-3 rounded-full font-semibold hover:bg-green-600 transition-colors">WhatsApp Us Now →</a>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type":"Question","name":"Can I use TikTok Shop with your wholesale service?","acceptedAnswer":{"@type":"Answer","text":"Yes! Many TikTok Shop sellers use us for both dropshipping and bulk orders. Our fast fulfillment helps maintain your shop metrics."}},{"@type":"Question","name":"Do you provide product photos for TikTok content?","acceptedAnswer":{"@type":"Answer","text":"Yes! All wholesale orders include professional product photos and video-ready lifestyle shots you can use for your TikTok content."}},{"@type":"Question","name":"What is the minimum order for TikTok Shop sellers?","acceptedAnswer":{"@type":"Answer","text":"Dropshipping orders have no minimum. For bulk orders, MOQ starts at 30-50 pieces per style with mix-and-match colors and sizes."}}]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://yogabulk-backup.pages.dev/"},
      {"@type": "ListItem", "position": 2, "name": "Success Stories", "item": "https://yogabulk-backup.pages.dev/success-stories/"},
      {"@type": "ListItem", "position": 3, "name": "James L.", "item": "https://yogabulk-backup.pages.dev/success-stories/tiktok-shop"}
    ]
  })} />
</BaseLayout>