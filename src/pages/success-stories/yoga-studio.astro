---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE, WHATSAPP } from "../../data/site";
---
<BaseLayout title="Yoga Studio Owner Success Story | Custom Branded Activewear" description="How a yoga studio owner created a branded activewear line for her studio, generating $15K in additional revenue with Wholesale Yoga.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <!-- Hero -->
    <section class="text-center mb-12">
      <p class="text-[var(--color-accent)] font-medium text-sm tracking-widest uppercase mb-3">Success Story</p>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--color-primary)] mb-4">🧘 Emma R. — Yoga Studio Owner, Australia</h1>
    </section>

    <!-- Stats -->
    <section class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-xl p-6 text-center">
        <p class="text-2xl sm:text-3xl font-bold text-[var(--color-accent)]">300%</p>
        <p class="text-sm text-gray-600 mt-1">Client Retention</p>
      </div>
      <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-xl p-6 text-center">
        <p class="text-2xl sm:text-3xl font-bold text-[var(--color-accent)]">$15K</p>
        <p class="text-sm text-gray-600 mt-1">Extra Revenue</p>
      </div>
      <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-xl p-6 text-center">
        <p class="text-2xl sm:text-3xl font-bold text-[var(--color-accent)]">200+</p>
        <p class="text-sm text-gray-600 mt-1">Sets Sold</p>
      </div>
      <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-xl p-6 text-center">
        <p class="text-2xl sm:text-3xl font-bold text-[var(--color-accent)]">4.9★</p>
        <p class="text-sm text-gray-600 mt-1">Feedback</p>
      </div>
    </section>

    <!-- Quote -->
    <section class="bg-[var(--color-bg-secondary)] rounded-2xl p-8 mb-12 border-l-4 border-[var(--color-primary)]">
      <blockquote class="text-lg italic text-[var(--color-text-secondary)]">
        "I was skeptical about ordering from China, but the quality blew me away. Seamless fabric is buttery soft. My students love the matching sets. Now I order monthly and it has become a significant revenue stream."
      </blockquote>
      <p class="mt-4 font-semibold text-[var(--color-text)]">— Emma R., Yoga Studio Owner, Australia</p>
    </section>

    <!-- Challenge -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-4">🔴 The Challenge</h2>
      <p class="text-[var(--color-text-secondary)] leading-relaxed">Emma runs a boutique yoga studio with 200+ members. She wanted to offer branded activewear as merchandise but could not find a supplier willing to do small custom orders. Local printers quoted $25+ per piece for custom leggings, making retail pricing uncompetitive. Her students kept asking about the activewear she wore in class.</p>
    </section>

    <!-- Solution -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-4">🟢 The Solution</h2>
      <p class="text-[var(--color-text-secondary)] leading-relaxed">She ordered 50 custom-logo matching sets from Wholesale Yoga with her studio logo heat-pressed on the waistband. The cost was under $8 per set, allowing her to retail at $35-45. Students loved the buttery-soft fabric and the studio branding. She now reorders monthly and has expanded to 4 styles with seasonal colors.</p>
    </section>

    <!-- Results -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-4">📊 Results</h2>
      <ul class="space-y-3">
        <li class="flex items-start gap-3">
          <span class="text-[var(--color-primary)] mt-1">✓</span>
          <span class="text-[var(--color-text-secondary)]">Generated $15,000+ in additional annual revenue from merchandise</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[var(--color-primary)] mt-1">✓</span>
          <span class="text-[var(--color-text-secondary)]">Client retention improved by 300% — members feel part of a community</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[var(--color-primary)] mt-1">✓</span>
          <span class="text-[var(--color-text-secondary)]">200+ branded sets sold in the first 6 months</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[var(--color-primary)] mt-1">✓</span>
          <span class="text-[var(--color-text-secondary)]">4.9-star average feedback from studio members</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[var(--color-primary)] mt-1">✓</span>
          <span class="text-[var(--color-text-secondary)]">Monthly reorder cycle keeps inventory fresh with seasonal colors</span>
        </li>
      </ul>
    </section>

    <!-- FAQ -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        <details class="bg-[var(--color-bg-secondary)] rounded-lg p-4 cursor-pointer">
          <summary class="font-semibold text-[var(--color-text)]">Can I get custom logo activewear for my studio?</summary>
          <p class="mt-3 text-[var(--color-text-secondary)]">Yes! We offer custom logo with heat transfer, embroidery, silicone, and screen printing. MOQ for custom logo is 50 pieces per style.</p>
        </details>
        <details class="bg-[var(--color-bg-secondary)] rounded-lg p-4 cursor-pointer">
          <summary class="font-semibold text-[var(--color-text)]">What is the typical turnaround for custom branded orders?</summary>
          <p class="mt-3 text-[var(--color-text-secondary)]">Custom logo orders take 7-10 business days for production plus 3-7 days shipping. Rush orders available for an additional fee.</p>
        </details>
        <details class="bg-[var(--color-bg-secondary)] rounded-lg p-4 cursor-pointer">
          <summary class="font-semibold text-[var(--color-text)]">Do you offer staff discount programs for studios?</summary>
          <p class="mt-3 text-[var(--color-text-secondary)]">Yes! Studios ordering 100+ pieces qualify for our studio partner program with 15% off all orders and priority production slots.</p>
        </details>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-[var(--color-secondary)] rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold text-[var(--color-primary)] mb-4">Be the Next Success Story</h2>
      <p class="text-gray-600 mb-6">Start with a small test order and scale with confidence.</p>
      <a href={WHATSAPP} target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-[var(--color-whatsapp)] text-white px-8 py-3 rounded-full font-semibold hover:bg-green-600 transition-colors">WhatsApp Us Now →</a>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type":"Question","name":"Can I get custom logo activewear for my studio?","acceptedAnswer":{"@type":"Answer","text":"Yes! We offer custom logo with heat transfer, embroidery, silicone, and screen printing. MOQ for custom logo is 50 pieces per style."}},{"@type":"Question","name":"What is the typical turnaround for custom branded orders?","acceptedAnswer":{"@type":"Answer","text":"Custom logo orders take 7-10 business days for production plus 3-7 days shipping. Rush orders available for an additional fee."}},{"@type":"Question","name":"Do you offer staff discount programs for studios?","acceptedAnswer":{"@type":"Answer","text":"Yes! Studios ordering 100+ pieces qualify for our studio partner program with 15% off all orders and priority production slots."}}]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://yogabulk-backup.pages.dev/"},
      {"@type": "ListItem", "position": 2, "name": "Success Stories", "item": "https://yogabulk-backup.pages.dev/success-stories/"},
      {"@type": "ListItem", "position": 3, "name": "Emma R.", "item": "https://yogabulk-backup.pages.dev/success-stories/yoga-studio"}
    ]
  })} />
</BaseLayout>