---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE, WHATSAPP } from "../../data/site";
---
<BaseLayout title="Amazon FBA Seller Success Story | From 50pcs to 5,000+ Monthly Sales" description="How an Amazon FBA seller scaled from a 50-piece test order to 5,000+ monthly sales with wholesale activewear from Wholesale Yoga.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <!-- Hero -->
    <section class="text-center mb-12">
      <p class="text-[var(--color-accent)] font-medium text-sm tracking-widest uppercase mb-3">Success Story</p>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--color-primary)] mb-4">📦 Sarah M. — Amazon FBA Seller, US</h1>
    </section>

    <!-- Stats -->
    <section class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-6 text-center">
        <p class="text-2xl sm:text-3xl font-bold text-[var(--color-accent)]">100x</p>
        <p class="text-sm text-gray-600 mt-1">Order Growth</p>
      </div>
      <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-6 text-center">
        <p class="text-2xl sm:text-3xl font-bold text-[var(--color-accent)]">4.8★</p>
        <p class="text-sm text-gray-600 mt-1">Amazon Rating</p>
      </div>
      <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-6 text-center">
        <p class="text-2xl sm:text-3xl font-bold text-[var(--color-accent)]">35%</p>
        <p class="text-sm text-gray-600 mt-1">Net Margin</p>
      </div>
      <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-6 text-center">
        <p class="text-2xl sm:text-3xl font-bold text-[var(--color-accent)]">5,000+</p>
        <p class="text-sm text-gray-600 mt-1">Monthly Sales</p>
      </div>
    </section>

    <!-- Quote -->
    <section class="bg-[var(--color-bg-secondary)] rounded-2xl p-8 mb-12 border-l-4 border-[var(--color-primary)]">
      <blockquote class="text-lg italic text-[var(--color-text-secondary)]">
        "Finally a supplier that actually has stock! I ordered 50pcs of their scrunch leggings and got them in 5 days. My listing hit Best Seller in 3 months. Already ordering 5,000+ pieces monthly."
      </blockquote>
      <p class="mt-4 font-semibold text-[var(--color-text)]">— Sarah M., Amazon FBA Seller, US</p>
    </section>

    <!-- Challenge -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-4">🔴 The Challenge</h2>
      <p class="text-[var(--color-text-secondary)] leading-relaxed">Sarah started selling activewear on Amazon in 2024 but struggled with inconsistent suppliers. Quality varied between shipments, delivery times were unpredictable, and she could not find a supplier willing to accept small test orders. Her listing reviews suffered from sizing inconsistencies and fabric quality issues.</p>
    </section>

    <!-- Solution -->
    <section class="mb-10">
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-4">🟢 The Solution</h2>
      <p class="text-[var(--color-text-secondary)] leading-relaxed">She found Wholesale Yoga through a seller forum and placed a 50-piece test order of scrunch leggings. The quality was consistent, delivery took 5 days via DHL, and the sizing was true-to-size. She scaled to 200 pieces the next month, then 500, and within 6 months was ordering 5,000+ pieces monthly across 8 styles.</p>
    </section>

    <!-- Results -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-4">📊 Results</h2>
      <ul class="space-y-3">
        <li class="flex items-start gap-3">
          <span class="text-[var(--color-primary)] mt-1">✓</span>
          <span class="text-[var(--color-text-secondary)]">Amazon Best Seller rank in 3 categories within 4 months</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[var(--color-primary)] mt-1">✓</span>
          <span class="text-[var(--color-text-secondary)]">4.8-star average rating across all listings (500+ reviews)</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[var(--color-primary)] mt-1">✓</span>
          <span class="text-[var(--color-text-secondary)]">35% net profit margin after FBA fees and advertising</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[var(--color-primary)] mt-1">✓</span>
          <span class="text-[var(--color-text-secondary)]">Expanded from 2 SKUs to 12 SKUs in 6 months</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-[var(--color-primary)] mt-1">✓</span>
          <span class="text-[var(--color-text-secondary)]">FBA shipment processing with FNSKU labeling included</span>
        </li>
      </ul>
    </section>

    <!-- FAQ -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-[var(--color-text)] mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        <details class="bg-[var(--color-bg-secondary)] rounded-lg p-4 cursor-pointer">
          <summary class="font-semibold text-[var(--color-text)]">How do I start selling activewear on Amazon FBA?</summary>
          <p class="mt-3 text-[var(--color-text-secondary)]">Start with a 30-50 piece test order to validate demand. We provide FNSKU labeling and direct shipping to FBA warehouses. Most new sellers break even within 2-3 months.</p>
        </details>
        <details class="bg-[var(--color-bg-secondary)] rounded-lg p-4 cursor-pointer">
          <summary class="font-semibold text-[var(--color-text)]">What is the typical profit margin for Amazon FBA activewear?</summary>
          <p class="mt-3 text-[var(--color-text-secondary)]">Most sellers achieve 30-40% net margins after FBA fees, advertising, and shipping costs. Our factory-direct pricing keeps your COGS low.</p>
        </details>
        <details class="bg-[var(--color-bg-secondary)] rounded-lg p-4 cursor-pointer">
          <summary class="font-semibold text-[var(--color-text)]">Can I customize products for my Amazon brand?</summary>
          <p class="mt-3 text-[var(--color-text-secondary)]">Yes! We offer custom labels, hang tags, and packaging. Many Amazon sellers build their own brand with our white-label service.</p>
        </details>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-[var(--color-secondary)] rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold text-[var(--color-primary)] mb-4">Be the Next Success Story</h2>
      <p class="text-gray-600 mb-6">Start with a small test order and scale with confidence.</p>
      <a href={WHATSAPP} target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-[var(--color-whatsapp)] text-white px-8 py-3 rounded-full font-semibold hover:bg-green-600 transition-colors">WhatsApp Us Now →</a>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{"@type":"Question","name":"How do I start selling activewear on Amazon FBA?","acceptedAnswer":{"@type":"Answer","text":"Start with a 30-50 piece test order to validate demand. We provide FNSKU labeling and direct shipping to FBA warehouses. Most new sellers break even within 2-3 months."}},{"@type":"Question","name":"What is the typical profit margin for Amazon FBA activewear?","acceptedAnswer":{"@type":"Answer","text":"Most sellers achieve 30-40% net margins after FBA fees, advertising, and shipping costs. Our factory-direct pricing keeps your COGS low."}},{"@type":"Question","name":"Can I customize products for my Amazon brand?","acceptedAnswer":{"@type":"Answer","text":"Yes! We offer custom labels, hang tags, and packaging. Many Amazon sellers build their own brand with our white-label service."}}]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://yogabulk-backup.pages.dev/"},
      {"@type": "ListItem", "position": 2, "name": "Success Stories", "item": "https://yogabulk-backup.pages.dev/success-stories/"},
      {"@type": "ListItem", "position": 3, "name": "Sarah M.", "item": "https://yogabulk-backup.pages.dev/success-stories/amazon-seller"}
    ]
  })} />
</BaseLayout>